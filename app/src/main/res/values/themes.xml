<resources>
    <style name="Theme.TermuxJavaUtils" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryDark">@color/purple_dark</item>
        <item name="colorAccent">@color/purple_light</item>
        <item name="android:windowBackground">@color/purple_surface</item>
        <item name="android:statusBarColor">@color/purple_dark</item>
        <item name="android:navigationBarColor">@color/purple_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialButtonStyle">@style/Widget.TermuxJavaUtils.Button</item>
    </style>

    <style name="Widget.TermuxJavaUtils.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/purple_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.TermuxJavaUtils.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/purple_light</item>
        <item name="android:textColor">@color/purple_light</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.TermuxJavaUtils.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="TextAppearance.TermuxJavaUtils.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TermuxJavaUtils.Subtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.TJU.Input" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/box_stroke</item>
        <item name="boxBackgroundColor">@color/purple_surface</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="hintTextColor">@color/accent_blue</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
        <item name="placeholderTextColor">@color/divider</item>
        <item name="errorTextColor">@color/error</item>
        <item name="endIconTint">@color/text_secondary</item>
    </style>

    <style name="Widget.TJU.EditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
